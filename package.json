{
  "name": "@local/offs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r run test",
    "check": "pnpm -r run check",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "pnpm -r run format",
    "format:fix": "pnpm -r run format:fix",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "fs:build": "pnpm --filter @offs/file-system run build",
    "fs:example:dev": "pnpm --filter offs-browser-example run dev",
    "fs:example:build": "pnpm --filter offs-browser-example run build",
    "fs:example:preview": "pnpm --filter offs-browser-example run preview",
    "fs:example:check": "pnpm --filter offs-browser-example run check",
    "validate": "pnpm run lint && pnpm run check && pnpm run packages:build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  },
  "pnpm": {
    "overrides": {
      "wasm-pack@*": "0.13.1"
    }
  }
}

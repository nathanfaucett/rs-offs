{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "esm",
    "declarationDir": "types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable", "ESNext.Symbol"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*", "types", "pkg"],
}

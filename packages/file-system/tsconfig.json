{
  "compilerOptions": {
    "rootDir": "./src",
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "esm",
    "declarationDir": "types/generated",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2021",
    "esModuleInterop": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable", "ESNext.Symbol"],
    "skipLibCheck": true,
    "incremental": false,
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*", "types"],
}

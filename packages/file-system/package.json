{
  "name": "@offs/file-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript wrapper for offs WASM (browser file system over OPFS + IndexedDB)",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "build:wasm": "cd ../../crates/wasm && wasm-pack build --target web --out-dir ../../packages/file-system/pkg --features browser --locked",
    "build:ts": "tsc -p tsconfig.json",
    "clean": "shx rm -rf esm types pkg tsconfig.tsbuildinfo",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "wasm-pack": "^0.13.0"
  },
  "files": [
    "esm",
    "types",
    "pkg"
  ]
}

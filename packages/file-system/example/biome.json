{
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*",
      "biome.json",
      "index.html",
      "package.json",
      "tsconfig.json",
      "vite.config.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}

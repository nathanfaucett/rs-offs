{
  "name": "@ofsdk/offs-browser-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser file system example for @ofsdk/file-system (Vite + Svelte + Tailwind)",
  "scripts": {
    "dev": "portless offs-example vite dev",
    "build": "vite build",
    "preview": "portless offs-example vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "dependencies": {
    "@ofsdk/file-system": "file:.."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "portless": "^0.15.4",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
